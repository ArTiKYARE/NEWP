---
// src/components/Header.astro
---
<header class="fixed-top py-3">
  <div class="container position-relative">
    <!-- Прогресс-бар вынесен за пределы хедера -->
    <div class="progress reading-progress">
      <div
        id="readingProgress"
        class="progress-bar bg-warning"
        role="progressbar"
        style="width: 0%"
      ></div>
    </div>
    <nav class="navbar navbar-expand-lg navbar-dark">
      <a class="navbar-brand fs-3 fw-bold" href="/">CarTuningLib</a>
      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="navbar-toggler-icon">      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <a class="nav-link active" href="/">Главная</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/news">Статьи</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/contacts">Контакты</a>
          </li>
        </ul>
      </div>
    </nav>
  </div>
</header>

<meta name="yandex-verification" content="48e9aea89685bec9" />

<style is:global>
  header {
    background: rgba(0, 0, 0, 0.7) !important;
    backdrop-filter: blur(10px);
    transition: background 0.3s ease;
   
  }

  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    z-index: 1040; /* Выше чем у хедера */
    border-radius: 0;
    background: transparent;
  }

  .progress-bar {
    transition: width 0.3s ease;
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function() {
    const progressBar = document.getElementById('readingProgress');
    
    const updateProgress = () => {
      const windowHeight = document.documentElement.clientHeight;
      const fullHeight = document.documentElement.scrollHeight;
      const scrolled = window.scrollY;
      
      const progress = (scrolled / (fullHeight - windowHeight)) * 100;
      progressBar.style.width = `${Math.min(progress, 100)}%`;
    };

    window.addEventListener('scroll', updateProgress);
    window.addEventListener('resize', updateProgress);
    updateProgress();
  });
</script>