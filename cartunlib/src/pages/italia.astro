---
// src/pages/japan.astro
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";

const cars = [
  {
    id: "supra-mk4",
    title: "Toyota Supra MK4",
    image: "/japan/main/mk4.png",
    specs: ["3.0L 2JZ-GTE", "320 л.с.", "RWD"],
    year: 1993,
    content: `
      <img src="/japan/main/mk4.png" class="img-fluid mb-4" alt="Toyota Supra MK4">
      <h2>Технические характеристики</h2>
      <ul>
        <li>Двигатель: 2JZ-GTE 3.0L Twin-Turbo</li>
        <li>Мощность: 320 л.с. (реально ~350)</li>
        <li>Коробка передач: 6-ст. механика или 4-ст. автомат</li>
        <li>Разгон 0-100: 4.6 сек</li>
      </ul>
      <h2>История</h2>
      <p>Toyota Supra впервые появилась в 1978 году как более длинный и мощный спин-офф Toyota Celica. Четвёртое поколение Supra, известное как MK4, выпускалось с начала 1990-х до 2002 года и стало самым успешным в гоночной истории модели. MK4 сохраняла классическую компоновку с передним двигателем и задним приводом. Этот автомобиль добился значительных успехов в автоспорте: побеждала в швейцарских горных гонках, участвовала в 24 часах Ле-Мана, покоряла Пайкс Пик, была конкурентоспособна в американских гонках SCCA и доминировала в японской серии All-Japan GT Championship с 1995 по 2003 год. Несмотря на успехи, к началу 2000-х спортивные автомобили теряли популярность на мировом рынке</p>
    `,
  },
  {
    id: "rx7-fd3s",
    title: "Mazda RX-7 FD3S",
    image: "/japan/main/rx7.png",
    specs: ["1.3L 13B-REW", "280 л.с.", "Ротор"],
    year: 2002,
    content: `
      <img src="/japan/main/rx7.png" class="img-fluid mb-4" alt="Mazda RX-7 FD3S">
      <h2>Технические характеристики</h2>
      <ul>
        <li>Двигатель: 13B-REW Twin-Rotor Twin-Turbo</li>
        <li>Мощность: 280 л.с. (реально ~300)</li>
        <li>Вес: 1250 кг</li>
        <li>Особенность: Роторный двигатель Ванкеля</li>
      </ul>
      <h2>История</h2>
      <h3>Mazda RX-7 FD3S (третье поколение)</h3>
      <p>Mazda RX-7 выпускалась с 1978 по 2002 год в трёх поколениях, все с роторным двигателем Ванкеля и задним приводом. Третье поколение RX-7, обозначаемое как FD3S, производилось с 1991 по 2002 год. Оно отличалось обновлённым дизайном и оснащалось 1.3-литровым 13B-REW двигателем с последовательным турбонаддувом — первой массово выпускаемой системой такого типа в Японии. Мощность достигала 255 л.с. в 1992 году и 280 л.с. к окончанию производства. RX-7 FD3S стала культовой в дрифте и автоспорте благодаря лёгкому корпусу и уникальному двигателю. Знаменитый дрифтер Мицуру Харагути сделал из RX-7 один из первых "HotBoi" дрифт-каров, который повлиял на культуру дрифта в 1990-х</p>
    `,
  },
  {
    id: "skyline-r34",
    title: "Nissan Skyline GT-R R34",
    image: "/japan/main/r34.png",
    specs: ["2.6L RB26DETT", "280 л.с.", "ATTESA"],
    year: 2002,
    content: `
      <img src="/japan/main/r34.png" class="img-fluid mb-4" alt="Nissan Skyline GT-R R34">
      <h2>Технические характеристики</h2>
      <ul>
        <li>Двигатель: RB26DETT 2.6L Twin-Turbo</li>
        <li>Привод: ATTESA E-TS Pro (полный с задним уклоном)</li>
        <li>Мощность: 280 л.с. (реально ~330)</li>
        <li>0-100 км/ч: 4.9 сек</li>
      </ul>
      <h2>История</h2>
      <p>Выпускался с 1999 по 2002 год. Последний Skyline с двигателем RB26 и культовым дизайном.</p>
    `,
  },
];
---

<Layout title="Японский тюнинг - CarTuningLibrary">
  <Header />

  <main class="container mt-5 pt-4">
    <!-- Заголовок -->
    <h1 class="text-center section-title mb-5 fade-in">Японский тюнинг</h1>

    <!-- Основной контент -->
    <section class="fade-in">
      <div class="row g-5 align-items-stretch">
        <div class="col-lg-6">
          <div class="bg-gradient p-4 rounded-3 shadow h-100">
            <h2 class="mb-4">Искусство японского тюнинга</h2>
            <p class="lead">
              В основе JDM-культуры лежит синтез инженерного мастерства и
              философии "моно-но аварэ" (очарование вещей), где каждая деталь
              обретает особую ценность.
            </p>
            <ul class="list-unstyled">
              <li class="mb-3">
                ➤ Двигатели - доведенные до совершенства механические симфонии
              </li>
              <li class="mb-3">
                ➤ Подвеска - хореография точности и управляемости
              </li>
              <li class="mb-3">➤ Дизайн - аэродинамическая поэзия в металле</li>
              <li class="mb-3">
                ➤ Интерьер - минимализм как высшая форма функциональности
              </li>
            </ul>
          </div>
        </div>

        <div class="col-lg-6">
          <div class="h-100">
            <img
              src="/japan/main/culture/j1.jpg"
              alt="Элегантный японский тюнинг: Nissan Skyline R34 на горном серпантине"
              class="img-fluid rounded-3 shadow w-100 h-100 object-fit-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Популярные модели с модальными окнами -->
    <section class="my-5 fade-in">
      <h2 class="section-title text-center mb-5">Легендарные модели</h2>
      <div class="row g-4">
        {
          cars.map((car) => (
            <div class="col-md-4">
              <div class="card article-card h-100">
                <img
                  src={car.image}
                  class="card-img-top"
                  alt={car.title}
                  loading="lazy"
                />
                <div class="card-body">
                  <h3 class="card-title fw-bold">{car.title}</h3>
                  <div class="d-flex justify-content-between mb-3">
                    <span class="badge bg-warning text-dark">{car.year}</span>
                    <div class="specs">
                      {car.specs.map((spec) => (
                        <span class="badge bg-secondary me-1">{spec}</span>
                      ))}
                    </div>
                  </div>
                  <button
                    class="btn btn-yellow w-100 car-modal-btn"
                    data-id={car.id}
                  >
                    Подробнее
                  </button>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Модальное окно для машин -->
    <div class="modal fade" id="carModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content bg-dark text-light">
          <div class="modal-header border-0">
            <h3 class="modal-title" id="carModalTitle"></h3>
            <button
              type="button"
              class="btn-close btn-close-white"
              data-bs-dismiss="modal"
              aria-label="Close"></button>
          </div>
          <div class="modal-body" id="carModalContent"></div>
          <div class="modal-footer border-0">
            <button type="button" class="btn btn-yellow" data-bs-dismiss="modal"
              >Закрыть</button
            >
          </div>
        </div>
      </div>
    </div>

    <!-- Культурный блок -->
    <section class="bg-gradient p-4 rounded-3 shadow my-5 fade-in">
      <h2 class="mb-4">Философия JDM</h2>
      <div class="row">
        <div class="col-md-6">
          <p class="lead">
            JDM (Japanese Domestic Market) - это не просто автомобили или
            тюнинг, а целая философия, объединяющая инженерное совершенство и
            культурное наследие. Основные принципы:
          </p>
          <ul>
            <li>
              <strong>Оригинальность превыше всего</strong> - использование аутентичных
              японских запчастей и комплектаций
            </li>
            <li>
              <strong>Уважение к инженерной мысли</strong> - сохранение заводского
              характера автомобиля с осмысленными доработками
            </li>
            <li>
              <strong>Качество важнее показухи</strong> - акцент на надежности и
              балансе, а не на гонке за лошадиными силами
            </li>
            <li>
              <strong>Минимализм и функциональность</strong> - чистый стиль без излишеств,
              где каждая деталь имеет назначение
            </li>
          </ul>
        </div>
        <div class="col-md-6">
          <img
            src="/japan/main/culture/j1.jpg"
            alt="Культура JDM: классический японский спортивный автомобиль"
            class="img-fluid rounded-3"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <section class="jdm-history py-5 fade-in">
      <div class="container">
        <h2 class="section-title text-center mb-5">
          История JDM: от послевоенного восстановления до мировой культуры
        </h2>

        <!-- 1950-1960-е -->
        <div class="row align-items-center mb-5 g-5">
          <div class="col-lg-6">
            <div class="article-card h-100">
              <img
                src="/japan/main/history/Toyota 2000GT 1967.png"
                alt="Toyota 2000GT 1967"
                class="img-fluid rounded-3 w-100"
                loading="lazy"
              />
            </div>
          </div>
          <div class="col-lg-6">
            <div class="bg-gradient p-4 rounded-3 shadow h-100">
              <h3 class="mb-4">1950–1960-е: Рождение японского автопрома</h3>
              <p>
                После Второй мировой Япония сосредоточилась на восстановлении.
                Первые модели были простыми и доступными:
              </p>
              <ul class="list-unstyled">
                <li class="mb-3">
                  ➤ <strong>Toyota SA (1947)</strong> - первый послевоенный автомобиль
                  с 4-цилиндровым 27-сильным двигателем
                </li>
                <li class="mb-3">
                  ➤ <strong>Datsun 1000 (1958)</strong> - компактный и экономичный,
                  начало экспорта
                </li>
                <li class="mb-3">
                  ➤ <strong>Toyota 2000GT (1967)</strong> - первый японский суперкар,
                  150 л.с., 220 км/ч
                </li>
              </ul>
              <div class="mt-4 p-3 bg-dark text-light rounded">
                <h5 class="text-warning">Культурный факт:</h5>
                <p>
                  2000GT снялся в бондиане "Живёшь только дважды" (1967),
                  впервые показав миру японский автопром.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- 1970-1980-е -->
        <div class="row align-items-center mb-5 g-5 flex-lg-row-reverse">
          <div class="col-lg-6">
            <div class="article-card h-100">
              <img
                src="/japan/main/history/Mazda RX-3 1971.png"
                alt="Mazda RX-3 1971"
                class="img-fluid rounded-3 w-100"
                loading="lazy"
              />
            </div>
          </div>
          <div class="col-lg-6">
            <div class="bg-gradient p-4 rounded-3 shadow h-100">
              <h3 class="mb-4">1970–1980-е: Нефтяной кризис и инновации</h3>
              <p>
                Кризис 1973 года заставил пересмотреть подход к
                автомобилестроению:
              </p>
              <ul class="list-unstyled">
                <li class="mb-3">
                  ➤ <strong>Mazda RX-3 (1971)</strong> - роторный двигатель 10A,
                  победа в 100-часовой гонке на Нюрбургринге
                </li>
                <li class="mb-3">
                  ➤ <strong>Nissan Skyline GT-R KPGC110 (1973)</strong> - последний
                  GT-R до 16-летнего перерыва
                </li>
                <li class="mb-3">
                  ➤ <strong>Honda Civic CVCC (1975)</strong> - первый двигатель,
                  соответствующий строгим американским нормам
                </li>
              </ul>
              <div class="mt-4 p-3 bg-dark text-light rounded">
                <h5 class="text-warning">Технология:</h5>
                <p>
                  CVCC (Compound Vortex Controlled Combustion) - революционная
                  система сгорания без катализатора.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- 1990-е -->
        <div class="row align-items-center mb-5 g-5">
          <div class="col-lg-6">
            <div class="article-card h-100">
              <img
                src="/japan/main/history/JDM Legends 1990s.png"
                alt="JDM Legends 1990s"
                class="img-fluid rounded-3 w-100"
                loading="lazy"
              />
            </div>
          </div>
          <div class="col-lg-6">
            <div class="bg-gradient p-4 rounded-3 shadow h-100">
              <h3 class="mb-4">1990-е: Золотой век JDM</h3>
              <p>Пик развития японских спортивных автомобилей:</p>
              <ul class="list-unstyled">
                <li class="mb-3">
                  ➤ <strong>Toyota Supra (JZA80, 1993)</strong> - 2JZ-GTE 3.0L Twin-Turbo,
                  280 л.с. (реально ~320)
                </li>
                <li class="mb-3">
                  ➤ <strong>Mazda RX-7 (FD3S, 1991)</strong> - 13B-REW 1.3L Twin-Rotor
                  Twin-Turbo, 255 л.с.
                </li>
                <li class="mb-3">
                  ➤ <strong>Nissan Skyline GT-R (BNR34, 1999)</strong> - RB26DETT
                  2.6L Twin-Turbo, ATTESA E-TS Pro
                </li>
              </ul>
              <div class="mt-4 p-3 bg-dark text-light rounded">
                <h5 class="text-warning">Гентльменское соглашение:</h5>
                <p>
                  С 1988 по 2004 год японские производители ограничивали
                  мощность 280 л.с., но реальные показатели часто были выше.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- 2000-е -->
        <div class="row align-items-center g-5 flex-lg-row-reverse">
          <div class="col-lg-6">
            <div class="article-card h-100">
              <img
                src="/japan/main/history/Modern JDM.png"
                alt="Modern JDM"
                class="img-fluid rounded-3 w-100"
                loading="lazy"
              />
            </div>
          </div>
          <div class="col-lg-6">
            <div class="bg-gradient p-4 rounded-3 shadow h-100">
              <h3 class="mb-4">2000-е - настоящее время: Глобализация JDM</h3>
              <p>Эволюция культуры в мировом масштабе:</p>
              <ul class="list-unstyled">
                <li class="mb-3">
                  ➤ <strong>2003</strong> - выход фильма "Форсаж: Токийский дрифт"
                </li>
                <li class="mb-3">
                  ➤ <strong>2007</strong> - прекращение производства Nissan Skyline
                  GT-R (R34)
                </li>
                <li class="mb-3">
                  ➤ <strong>2019</strong> - возвращение Toyota Supra (A90) с BMW
                  B58 двигателем
                </li>
              </ul>
              <div class="mt-4 p-3 bg-dark text-light rounded">
                <h5 class="text-warning">Рынок:</h5>
                <p>
                  Цены на R34 GT-R выросли с $30,000 в 2000-х до $200,000+ в
                  2020-х. Оригинальные AE86 в хорошем состоянии стоят $50,000+.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    // Данные для модальных окон
    const carData = {
      "supra-mk4": {
        title: "Toyota Supra MK4",
        content: `
          <img src="/japan/main/mk4.png" class="img-fluid mb-4" alt="Toyota Supra MK4">
          <h2>Технические характеристики</h2>
          <ul>
            <li>Двигатель: 2JZ-GTE 3.0L Twin-Turbo</li>
            <li>Мощность: 320 л.с. (реально ~350)</li>
            <li>Коробка передач: 6-ст. механика или 4-ст. автомат</li>
            <li>Разгон 0-100: 4.6 сек</li>
          </ul>
          <h2>История</h2>
          <h4>Toyota Supra MK4 (четвёртое поколение)</h4>
      <p>Toyota Supra впервые появилась в 1978 году как более длинный и мощный спин-офф Toyota Celica. Четвёртое поколение Supra, известное как MK4, выпускалось с начала 1990-х до 2002 года и стало самым успешным в гоночной истории модели. MK4 сохраняла классическую компоновку с передним двигателем и задним приводом. Этот автомобиль добился значительных успехов в автоспорте: побеждала в швейцарских горных гонках, участвовала в 24 часах Ле-Мана, покоряла Пайкс Пик, была конкурентоспособна в американских гонках SCCA и доминировала в японской серии All-Japan GT Championship с 1995 по 2003 год. Несмотря на успехи, к началу 2000-х спортивные автомобили теряли популярность на мировом рынке</p>
        `,
      },
      "rx7-fd3s": {
        title: "Mazda RX-7 FD3S",
        content: `
          <img src="/japan/main/rx7.png" class="img-fluid mb-4" alt="Mazda RX-7 FD3S">
          <h2>Технические характеристики</h2>
          <ul>
            <li>Двигатель: 13B-REW Twin-Rotor Twin-Turbo</li>
            <li>Мощность: 280 л.с. (реально ~300)</li>
            <li>Вес: 1250 кг</li>
            <li>Особенность: Роторный двигатель Ванкеля</li>
          </ul>
          <h2>История</h2>
          <h4>Mazda RX-7 FD3S (третье поколение)</h4>
      <p>Mazda RX-7 выпускалась с 1978 по 2002 год в трёх поколениях, все с роторным двигателем Ванкеля и задним приводом. Третье поколение RX-7, обозначаемое как FD3S, производилось с 1991 по 2002 год. Оно отличалось обновлённым дизайном и оснащалось 1.3-литровым 13B-REW двигателем с последовательным турбонаддувом — первой массово выпускаемой системой такого типа в Японии. Мощность достигала 255 л.с. в 1992 году и 280 л.с. к окончанию производства. RX-7 FD3S стала культовой в дрифте и автоспорте благодаря лёгкому корпусу и уникальному двигателю. Знаменитый дрифтер Мицуру Харагути сделал из RX-7 один из первых "HotBoi" дрифт-каров, который повлиял на культуру дрифта в 1990-х</p>
        `,
      },
      "skyline-r34": {
        title: "Nissan Skyline GT-R R34",
        content: `
          <img src="/japan/main/r34.png" class="img-fluid mb-4" alt="Nissan Skyline GT-R R34">
          <h2>Технические характеристики</h2>
          <ul>
            <li>Двигатель: RB26DETT 2.6L Twin-Turbo</li>
            <li>Привод: ATTESA E-TS Pro (полный с задним уклоном)</li>
            <li>Мощность: 280 л.с. (реально ~330)</li>
            <li>0-100 км/ч: 4.9 сек</li>
          </ul>
          <h2>История</h2>
          <h4>Nissan Skyline GT-R R34 (пятое поколение)</h4>
      <p>Skyline GT-R — спортивная версия Nissan Skyline, впервые выпущенная в 1969 году. После перерыва в 16 лет, в 1989 году возродился GT-R с моделью R32, которая получила прозвище "Godzilla" за доминирование в гонках. Пятое поколение, R34, выпускалось с 1999 по 2002 год и стало одной из самых известных иконических моделей. R34 оснащался передним двигателем и полным приводом с системой ATTESA E-TS и четырёхколёсным рулевым управлением Super-HICAS. Модель получила 6-ступенчатую коробку передач и мощный двигатель, а также улучшенную управляемость. R34 GT-R стал популярным не только в Японии, но и на экспортных рынках, а также получил широкую известность в поп-культуре, включая фильмы и видеоигры </p>
        `,
      },
    };

    // Обработчики для модальных окон машин
    document.querySelectorAll(".car-modal-btn").forEach((btn) => {
      btn.addEventListener("click", function () {
        const carId = this.dataset.id;
        const car = carData[carId];

        document.getElementById("carModalTitle").textContent = car.title;
        document.getElementById("carModalContent").innerHTML = car.content;
        new bootstrap.Modal(document.getElementById("carModal")).show();
      });
    });
  });
  // Оригинальные скрипты без изменений
  document.addEventListener("DOMContentLoaded", function () {
    // Скрипт для темы
    document
      .getElementById("themeToggle")
      .addEventListener("click", function () {
        document.body.classList.toggle("dark-theme");
        // ... остальной код
      });

    // Скрипт для кнопки "Наверх"
    const backToTopButton = document.getElementById("back-to-top");
    window.addEventListener("scroll", function () {
      if (window.scrollY > 300) {
        backToTopButton.style.display = "flex";
      } else {
        backToTopButton.style.display = "none";
      }
    });

    // Остальные скрипты...
  });
</script>

