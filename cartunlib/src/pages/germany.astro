---
// src/pages/germany.astro
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";

const cars = [
  {
    id: "golf-gti",
    title: "Volkswagen Golf GTI",
    image: "/germany/golf-gti.webp",
    specs: ["2.0L TSI", "245 л.с.", "FWD"],
    year: 2022,
    content: `
      <img src="/germany/golf-gti.webp" class="img-fluid mb-4 rounded-3" alt="Volkswagen Golf GTI">
      <h2>Технические характеристики</h2>
      <ul>
        <li>Двигатель: 2.0L TSI турбированный</li>
        <li>Мощность: 245 л.с. (после тюнинга до 350 л.с.)</li>
        <li>Разгон 0-100: 6.3 сек (5.1 сек после тюнинга)</li>
        <li>Особенности: VAQ дифференциал, спортивная подвеска</li>
      </ul>
      <h2>История тюнинга</h2>
      <p>Golf GTI - икона хот-хэтч сегмента с 1976 года. Немецкие тюнинг-ателье как ABT и Oettinger предлагают комплекты для увеличения мощности, улучшения аэродинамики и ходовой части. Популярен для трек-дней и городского использования.</p>
    `,
  },
  {
    id: "bmw-m3",
    title: "BMW M3 (G80)",
    image: "/germany/bmw-m3.webp",
    specs: ["3.0L S58", "510 л.с.", "RWD/AWD"],
    year: 2021,
    content: `
      <img src="/germany/bmw-m3-detail.webp" class="img-fluid mb-4 rounded-3" alt="BMW M3 G80">
      <h2>Технические характеристики</h2>
      <ul>
        <li>Двигатель: 3.0L S58 Twin-Turbo</li>
        <li>Мощность: 510 л.с. (до 700+ л.с. с тюнингом)</li>
        <li>Крутящий момент: 650 Нм</li>
        <li>0-100 км/ч: 3.9 сек (3.2 сек после тюнинга)</li>
      </ul>
      <h2>Тюнинг-культура</h2>
      <p>M3 G80 - любимец немецких тюнеров. Компании типа AC Schnitzer и G-Power предлагают:</p>
      <ul>
        <li>Полные кит-комплекты мощностью до 720 л.с.</li>
        <li>Карбоновые аэродинамические пакеты</li>
        <li>Тюнингованную подвеску с регулируемой жесткостью</li>
      </ul>
    `,
  },
  {
    id: "mercedes-amg-gt",
    title: "Mercedes-AMG GT",
    image: "/germany/amg-gt.webp",
    specs: ["4.0L V8", "523 л.с.", "RWD"],
    year: 2023,
    content: `
      <img src="/germany/amg-gt-detail.webp" class="img-fluid mb-4 rounded-3" alt="Mercedes-AMG GT">
      <h2>Технические характеристики</h2>
      <ul>
        <li>Двигатель: 4.0L V8 Biturbo</li>
        <li>Мощность: 523 л.с. (до 800 л.с. у Brabus)</li>
        <li>Коробка: AMG SPEEDSHIFT DCT 7G</li>
        <li>Тюнинг: Полный карбоновый обвес</li>
      </ul>
      <h2>Премиум тюнинг</h2>
      <p>AMG GT - эталон немецкого инженерного искусства. Тюнинг-ателье Brabus и Mansory создают:</p>
      <ul>
        <li>Эксклюзивные интерьеры с кожей и алькантарой</li>
        <li>Мощностные комплекты Stage 3</li>
        <li>Агрессивные аэродинамические обвесы</li>
      </ul>
    `,
  },
];
---

<Layout title="Немецкий тюнинг - CarTuningLibrary">
  <Header />

  <main class="container mt-5 pt-4">
    <!-- Заголовок -->
    <h1 class="text-center section-title mb-5 fade-in">Немецкий тюнинг</h1>

    <!-- Основной контент -->
    <section class="fade-in">
      <div class="row g-5 align-items-stretch">
        <div class="col-lg-6">
          <div class="bg-gradient p-4 rounded-3 shadow h-100 d-flex flex-column">
            <h2 class="mb-4">Философия немецкого тюнинга</h2>
            <p class="lead flex-grow-1">
              Немецкий тюнинг — это симбиоз инженерного совершенства и безкомпромиссного качества.
              Здесь каждая модификация проходит строгие тесты на безопасность и надежность.
            </p>
            <ul class="list-unstyled mb-0">
              <li class="mb-3">
                ➤ <strong>Инженерия</strong> — точные расчеты и тестирование
              </li>
              <li class="mb-3">
                ➤ <strong>Качество</strong> — только сертифицированные компоненты
              </li>
              <li class="mb-3">➤ <strong>Производительность</strong> — баланс мощности и управляемости</li>
              <li class="mb-0">
                ➤ <strong>Эстетика</strong> — сдержанный и функциональный дизайн
              </li>
            </ul>
          </div>
        </div>

        <div class="col-lg-6">
          <div class="h-100">
            <img
              src="/germany/german-tuning-main.webp"
              alt="Немецкий тюнинг - Mercedes-AMG на Нюрбургринге"
              class="img-fluid rounded-3 shadow w-100 h-100 object-fit-cover"
              loading="lazy"
              style="min-height: 100%"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Популярные модели с модальными окнами -->
    <section class="my-5 fade-in">
      <h2 class="section-title text-center mb-5">Легендарные модели</h2>
      <div class="row g-4">
        {
          cars.map((car) => (
            <div class="col-md-4 d-flex">
              <div class="card article-card w-100">
                <div class="card-img-container" style="height: 300px; overflow: hidden;">
                  <img
                    src={car.image}
                    class="card-img-top h-100 w-100 object-fit-cover"
                    alt={car.title}
                    loading="lazy"
                  />
                </div>
                <div class="card-body d-flex flex-column">
                  <h3 class="card-title fw-bold">{car.title}</h3>
                  <div class="d-flex justify-content-between mb-3">
                    <span class="badge bg-warning text-dark">{car.year}</span>
                    <div class="specs">
                      {car.specs.map((spec) => (
                        <span class="badge bg-secondary me-1">{spec}</span>
                      ))}
                    </div>
                  </div>
                  <button
                    class="btn btn-yellow w-100 car-modal-btn mt-auto"
                    data-id={car.id}
                  >
                    Подробнее
                  </button>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Модальное окно для машин -->
    <div class="modal fade" id="carModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content bg-dark text-light">
          <div class="modal-header border-0">
            <h3 class="modal-title" id="carModalTitle"></h3>
            <button
              type="button"
              class="btn-close btn-close-white"
              data-bs-dismiss="modal"
              aria-label="Close"></button>
          </div>
          <div class="modal-body" id="carModalContent"></div>
          <div class="modal-footer border-0">
            <button type="button" class="btn btn-yellow" data-bs-dismiss="modal"
              >Закрыть</button
            >
          </div>
        </div>
      </div>
    </div>

    <!-- Культурный блок -->
    <section class="bg-gradient p-4 rounded-3 shadow my-5 fade-in">
      <h2 class="mb-4">Культура немецкого тюнинга</h2>
      <div class="row align-items-center">
        <div class="col-md-6">
          <p class="lead">
            Немецкий тюнинг отличается системным подходом и имеет свои традиции:
          </p>
          <ul>
            <li>
              <strong>Официальные тюнинг-ателье</strong> — ABT, Brabus, AC Schnitzer
            </li>
            <li>
              <strong>Технический контроль (TÜV)</strong> — все доработки сертифицируются
            </li>
            <li>
              <strong>Трек-ориентированность</strong> — тестирование на Нюрбургринге
            </li>
            <li>
              <strong>Премиум материалы</strong> — карбон, алюминий, кожа
            </li>
          </ul>
        </div>
        <div class="col-md-6">
          <img
            src="/germany/nurburgring.webp"
            alt="Тюнингованные автомобили на Нюрбургринге"
            class="img-fluid rounded-3 shadow"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- История -->
    <section class="german-history py-5 fade-in">
      <div class="container">
        <h2 class="section-title text-center mb-5">
          История немецкого тюнинга
        </h2>

        <!-- 1970-1980-е -->
        <div class="row align-items-stretch mb-5 g-5">
          <div class="col-lg-6 d-flex">
            <div class="article-card w-100">
              <img
                src="/germany/70s-tuning.webp"
                alt="Немецкий тюнинг 1970-80-х"
                class="img-fluid rounded-3 w-100 h-100 object-fit-cover"
                style="min-height: 350px;"
                loading="lazy"
              />
            </div>
          </div>
          <div class="col-lg-6 d-flex">
            <div class="bg-gradient p-4 rounded-3 shadow w-100 d-flex flex-column">
              <h3 class="mb-4">1970–1980-е: Зарождение культуры</h3>
              <p>
                Первые специализированные тюнинг-компании и легендарные модели:
              </p>
              <ul class="list-unstyled mb-4">
                <li class="mb-3">
                  ➤ <strong>1976</strong> — Первый Golf GTI от Volkswagen
                </li>
                <li class="mb-3">
                  ➤ <strong>1977</strong> — Основание ABT Sportsline
                </li>
                <li class="mb-3">
                  ➤ <strong>1986</strong> — Первый тюнингованный Mercedes от Brabus
                </li>
              </ul>
              <div class="mt-auto p-3 bg-dark text-light rounded">
                <h5 class="text-warning">Факт:</h5>
                <p class="mb-0">
                  В 1980-х появился термин "German Tuning" как знак качества.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- 1990-2000-е -->
        <div class="row align-items-stretch mb-5 g-5 flex-lg-row-reverse">
          <div class="col-lg-6 d-flex">
            <div class="article-card w-100">
              <img
                src="/germany/90s-tuning.webp"
                alt="Немецкий тюнинг 1990-2000-х"
                class="img-fluid rounded-3 w-100 h-100 object-fit-cover"
                style="min-height: 350px;"
                loading="lazy"
              />
            </div>
          </div>
          <div class="col-lg-6 d-flex">
            <div class="bg-gradient p-4 rounded-3 shadow w-100 d-flex flex-column">
              <h3 class="mb-4">1990–2000-е: Технологический прорыв</h3>
              <p>
                Развитие электронных систем и новых материалов:
              </p>
              <ul class="list-unstyled mb-4">
                <li class="mb-3">
                  ➤ <strong>1992</strong> — Первые чип-тюнинг системы
                </li>
                <li class="mb-3">
                  ➤ <strong>1997</strong> — Карбоновые кузова от Hamann
                </li>
                <li class="mb-3">
                  ➤ <strong>2004</strong> — Технологии двойного турбонаддува
                </li>
              </ul>
              <div class="mt-auto p-3 bg-dark text-light rounded">
                <h5 class="text-warning">Технология:</h5>
                <p class="mb-0">
                  В 1990-х немцы первыми внедрили OBD-тюнинг через диагностический разъем.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- 2010-е -->
        <div class="row align-items-stretch mb-5 g-5">
          <div class="col-lg-6 d-flex">
            <div class="article-card w-100">
              <img
                src="/germany/2010s-tuning.webp"
                alt="Немецкий тюнинг 2010-х"
                class="img-fluid rounded-3 w-100 h-100 object-fit-cover"
                style="min-height: 350px;"
                loading="lazy"
              />
            </div>
          </div>
          <div class="col-lg-6 d-flex">
            <div class="bg-gradient p-4 rounded-3 shadow w-100 d-flex flex-column">
              <h3 class="mb-4">2010-е: Эра гипер-тюнинга</h3>
              <p>Экстремальные проекты и рекорды мощности:</p>
              <ul class="list-unstyled mb-4">
                <li class="mb-3">
                  ➤ <strong>2012</strong> — Brabus 800 с 800 л.с.
                </li>
                <li class="mb-3">
                  ➤ <strong>2015</strong> — ABT RS6+ (730 л.с.)
                </li>
                <li class="mb-3">
                  ➤ <strong>2018</strong> — Mansory Carbonado (750 л.с.)
                </li>
              </ul>
              <div class="mt-auto p-3 bg-dark text-light rounded">
                <h5 class="text-warning">Рекорд:</h5>
                <p class="mb-0">
                  В 2019 году тюнингованный Porsche 911 разогнался до 358 км/ч на Нюрбургринге.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- 2020-е -->
        <div class="row align-items-stretch g-5 flex-lg-row-reverse">
          <div class="col-lg-6 d-flex">
            <div class="article-card w-100">
              <img
                src="/germany/2020s-tuning.webp"
                alt="Современный немецкий тюнинг"
                class="img-fluid rounded-3 w-100 h-100 object-fit-cover"
                style="min-height: 350px;"
                loading="lazy"
              />
            </div>
          </div>
          <div class="col-lg-6 d-flex">
            <div class="bg-gradient p-4 rounded-3 shadow w-100 d-flex flex-column">
              <h3 class="mb-4">2020-е: Электрификация и AI</h3>
              <p>Новые вызовы и технологии:</p>
              <ul class="list-unstyled mb-4">
                <li class="mb-3">
                  ➤ <strong>Тюнинг электромобилей</strong> — Porsche Taycan от TechArt
                </li>
                <li class="mb-3">
                  ➤ <strong>Цифровой тюнинг</strong> — облачные настройки
                </li>
                <li class="mb-3">
                  ➤ <strong>AI-оптимизация</strong> — машинное обучение для настройки
                </li>
              </ul>
              <div class="mt-auto p-3 bg-dark text-light rounded">
                <h5 class="text-warning">Тренд:</h5>
                <p class="mb-0">
                  Немецкие тюнеры разрабатывают "зеленый" тюнинг с улучшенной экологичностью.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  // Данные для модальных окон
  const carData = {
    "golf-gti": {
      title: "Volkswagen Golf GTI",
      content: `
        <img src="/germany/golf-gti-detail.webp" class="img-fluid mb-4 rounded-3" alt="Volkswagen Golf GTI">
        <h2>Технические характеристики</h2>
        <ul>
          <li>Двигатель: 2.0L TSI турбированный</li>
          <li>Мощность: 245 л.с. (после тюнинга до 350 л.с.)</li>
          <li>Разгон 0-100: 6.3 сек (5.1 сек после тюнинга)</li>
          <li>Особенности: VAQ дифференциал, спортивная подвеска</li>
        </ul>
        <h2>История тюнинга</h2>
        <p>Golf GTI - икона хот-хэтч сегмента с 1976 года. Немецкие тюнинг-ателье как ABT и Oettinger предлагают комплекты для увеличения мощности, улучшения аэродинамики и ходовой части. Популярен для трек-дней и городского использования.</p>
      `
    },
    "bmw-m3": {
      title: "BMW M3 (G80)",
      content: `
        <img src="/germany/bmw-m3-detail.webp" class="img-fluid mb-4 rounded-3" alt="BMW M3 G80">
        <h2>Технические характеристики</h2>
        <ul>
          <li>Двигатель: 3.0L S58 Twin-Turbo</li>
          <li>Мощность: 510 л.с. (до 700+ л.с. с тюнингом)</li>
          <li>Крутящий момент: 650 Нм</li>
          <li>0-100 км/ч: 3.9 сек (3.2 сек после тюнинга)</li>
        </ul>
        <h2>Тюнинг-культура</h2>
        <p>M3 G80 - любимец немецких тюнеров. Компании типа AC Schnitzer и G-Power предлагают:</p>
        <ul>
          <li>Полные кит-комплекты мощностью до 720 л.с.</li>
          <li>Карбоновые аэродинамические пакеты</li>
          <li>Тюнингованную подвеску с регулируемой жесткостью</li>
        </ul>
      `
    },
    "mercedes-amg-gt": {
      title: "Mercedes-AMG GT",
      content: `
        <img src="/germany/amg-gt-detail.webp" class="img-fluid mb-4 rounded-3" alt="Mercedes-AMG GT">
        <h2>Технические характеристики</h2>
        <ul>
          <li>Двигатель: 4.0L V8 Biturbo</li>
          <li>Мощность: 523 л.с. (до 800 л.с. у Brabus)</li>
          <li>Коробка: AMG SPEEDSHIFT DCT 7G</li>
          <li>Тюнинг: Полный карбоновый обвес</li>
        </ul>
        <h2>Премиум тюнинг</h2>
        <p>AMG GT - эталон немецкого инженерного искусства. Тюнинг-ателье Brabus и Mansory создают:</p>
        <ul>
          <li>Эксклюзивные интерьеры с кожей и алькантарой</li>
          <li>Мощностные комплекты Stage 3</li>
          <li>Агрессивные аэродинамические обвесы</li>
        </ul>
      `
    }
  };

  // Обработчики для модальных окон машин
  document.querySelectorAll(".car-modal-btn").forEach((btn) => {
    btn.addEventListener("click", function () {
      const carId = this.dataset.id;
      const car = carData[carId];

      document.getElementById("carModalTitle").textContent = car.title;
      document.getElementById("carModalContent").innerHTML = car.content;
      new bootstrap.Modal(document.getElementById("carModal")).show();
    });
  });
</script>

<style scoped>
  .german-history .bg-gradient {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    border-left: 4px solid #e63946;
  }
  
  .btn-yellow {
    background-color: #e63946;
    color: white;
  }
  
  .btn-yellow:hover {
    background-color: #c1121f;
  }
  
  .section-title::after {
    background: #e63946;
  }
</style>