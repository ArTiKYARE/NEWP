// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import BackToTop from "../components/BackToTop.astro";
import Footer from "../components/Footer.astro";

// Данные для стран
const countries = [
	{
		name: "Япония",
		flag: "/flags/jpn_flag.png",
		link: "/japan",
	},
	{
		name: "США",
		flag: "/flags/usa_flag.png",
		link: "/usa",
	},
	{
		name: "Россия",
		flag: "/flags/RU.png",
		link: "/russia",
	},
	{
		name: "Великобритания",
		flag: "/flags/uk_flag.png",
		link: "/uk",
	},
	{
		name: "Германия",
		flag: "/flags/de_flag.png",
		link: "/germany",
	},
	{
		name: "Южная Корея",
		flag: "/flags/kr_flag.png",
		link: "/south-korea",
	},
	{
		name: "Италия",
		flag: "/flags/it_flag.png",
		link: "/italy",
	},
	{
		name: "Франция",
		flag: "/flags/fr_flag.png",
		link: "/france",
	},
];

const articles = [
	{
		id: "1",
		title: "Эволюция двигателя 2JZ-GTE",
		image: "/news/indexnews/2JZ-GTE.png",
		excerpt: "Полный разбор легендарного двигателя Toyota",
		category: "Технологии",
		modal: true,
		content: `
      <img src="/news/indexnews/2JZ-GTE.png" class="img-fluid mb-4" alt="Двигатель 2JZ-GTE">
  
  <h2>1991-1993: Первое поколение</h2>
  <p>Дебют в Toyota Aristo V. 3.0L twin-turbo I6 (280 л.с.), чугунный блок, алюминиевая ГБЦ.</p>
  
  <h2>1993-1997: Supra MKIV</h2>
  <p>Улучшенные турбины CT12A, система VVT-i. Заводской потенциал - 500+ л.с.</p>
  
  <h2>1997-2002: Последние годы</h2>
  <p>Электронная дроссельная заслонка, OBD-II. Самые надежные экземпляры.</p>
  
  <h2>Конструктивные особенности</h2>
  <ul>
    <li>Чугунный блок с запасами прочности до 1000+ л.с.</li>
    <li>Шестеренчатый привод ГРМ (нет ремня!)</li>
    <li>Двойные турбины с последовательным наддувом</li>
  </ul>
  
  <h2>Легендарные тюнинг-проекты</h2>
  <p><strong>Smokey Nagata's Supra</strong> - 1000+ л.с., 300+ км/ч по автомагистралям</p>
  <p><strong>HKS Drag Supra</strong> - 7-секундный квартал мили</p>
  
  <h2>Современное наследие</h2>
  <p>2JZ остается самым востребованным для swaps. Новые турбо-киты и ECU раскрывают 800+ л.с. на стоковом блоке.</p>
    `,
	},
	{
		id: "2",
		title: "История Nissan Skyline GT-R",
		image: "/news/indexnews/Nissan Skyline GT-R.png",
		excerpt: "Как скромный седан превратился в суперкар",
		category: "История",
		modal: true,
		content: `
      <img src="public/news/indexnews/Nissan Skyline GT-R.png" class="img-fluid mb-4" alt="Nissan Skyline GT-R">
  
  <h2>Рождение легенды: 1969-1972</h2>
  <p>Первый Skyline GT-R (PGC10) с 2.0L S20 I6 (160 л.с.) - доминировал в японских гонках, 52 победы подряд.</p>
  
  <h2>Темные века: 1973-1988</h2>
  <p>Нефтяной кризис убил спортивные модели. Skyline стал семейным седаном.</p>
  
  <h2>Возрождение: R32 (1989-1994)</h2>
  <p>"Godzilla" с RB26DETT (280 л.с.), полным приводом ATTESA E-TS. Уничтожал конкурентов в Group A.</p>
  
  <h2>Эволюция: R33 (1995-1998)</h2>
  <p>Улучшенная аэродинамика, активный дифференциал. Самый редкий GT-R - Nismo 400R.</p>
  
  <h2>Апогей: R34 (1999-2002)</h2>
  <p>Последний "настоящий" GT-R с технологиями из JGTC. Мультидисплей, 340 км/ч спидометр.</p>
  
  <h2>Современная эра: R35 (2007-н.в.)</h2>
  <p>3.8L VR38DETT, двойное сцепление. Уже не Skyline, но продолжает традиции.</p>
  
  <h2>Культовые модификации</h2>
  <ul>
    <li>Nismo Z-Tune (R34) - 500 л.с., $500k+</li>
    <li>Mine's R34 - эталон тюнинга 2000-х</li>
    <li>Mid Night Club - легендарные стрит-рейсеры</li>
  </ul>
    `,
	},
	{
		id: "3",
		title: "10 лучших JDM-автомобилей для дрифта",
		image: "/news/indexnews/JDM дрифт.png",
		excerpt: "От AE86 до неожиданных вариантов для начинающих",
		category: "Тюнинг",
		modal: true,
		content: `
      <img src="/news/indexnews/JDM дрифт.png" class="img-fluid mb-4" alt="JDM дрифт-кар">
  <h2>Лучшие японские машины для дрифта</h2>
  <h3>1. Toyota AE86 (1983-1987)</h3>
  <p>Культовая модель благодаря Initial D. Легкий (менее 1000 кг), заднеприводный, с 1.6L 4A-GE двигателем (128 л.с.). Идеальный баланс и механическая КПП.</p>
  <h3>2. Nissan Silvia S13/S14/S15 (1988-2002)</h3>
  <p>Сердце дрифт-культуры. SR20DET турбо-двигатель, простая подвеска для модификаций. S15 с 250 л.с. - вершина серии.</p>
  <h3>3. Mazda RX-7 FD3S (1992-2002)</h3>
  <p>Роторный 13B-REW Twin-Turbo (280 л.с.), идеальное распределение веса 50:50. Сложен в обслуживании, но неповторим в дрифте.</p>
  <h3>4. Nissan Skyline R32/R33/R34 GT-T</h3>
  <p>RB25DET турбо-двигатель, полный привод (можно переделать в RWD). Мощность и стабильность.</p>
  <h3>5. Toyota Supra MK3 (1986-1992)</h3>
  <p>1JZ-GTE (280 л.с.) с отличным потенциалом для тюнинга. Жесткая конструкция кузова.</p>
  <h3>6. Nissan 180SX/200SX (1989-1998)</h3>
  <p>Дешевле Silvia, но с тем же SR20DET. Популярный "хачи-року" в кузове купе.</p>
  <h3>7. Toyota Chaser/Mark II (1992-2001)</h3>
  <p>1JZ/2JZ двигатели в 4-дверном кузове. "Секретное оружие" японских дрифтеров.</p>
  <h3>8. Honda S2000 (1999-2009)</h3>
  <p>F20C (240 л.с. с 9000 об/мин!) - механика для профессионалов. Сложен для новичков.</p>
  <h3>9. Subaru Impreza GC8 (с RWD конверсией)</h3>
  <p>Нестандартный выбор, но с правильными доработками - машина мечты.</p>
  <h3>10. Toyota Soarer (Z30)</h3>
  <p>Люкс-купе с 1JZ-GTE, часто недооценено дрифтерами.</p>
  <h2>Советы начинающим</h2>
  <ul>
    <li>AE86/Silvia - лучший выбор для старта</li>
    <li>Избегайте автоматических коробок</li>
    <li>Бюджет на доработки должен быть равен цене авто</li>
  </ul>
    `,
	},
];
---

<Layout title="Главная - CarTuningLibrary">
	<Header />

	<main>
		<!-- Карусель -->
		<section id="home" class="mt-5">
			<div class="wide-container">
				<div
					id="carouselExample"
					class="carousel slide"
					data-bs-ride="carousel"
				>
					<div class="carousel-indicators">
						<button
							type="button"
							data-bs-target="#carouselExample"
							data-bs-slide-to="0"
							class="active"></button>
						<button
							type="button"
							data-bs-target="#carouselExample"
							data-bs-slide-to="1"></button>
						<button
							type="button"
							data-bs-target="#carouselExample"
							data-bs-slide-to="2"></button>
					</div>

					<div class="carousel-inner">
						<!-- Слайд 1 -->
						<div
							class="carousel-item active"
							data-bs-interval="5000"
						>
							<img
								src="/index/karusel/k1.jpg"
								class="d-block w-100"
								alt="Тюнинг"
							/>
							<div class="carousel-caption">
								<h1 class="display-4 fw-bold">
									Добро пожаловать в мир тюнинга
								</h1>
								<p class="lead">
									Уникальные решения для стиля и
									производительности
								</p>
								<a href="#tuning" class="btn btn-yellow"
									>Посмотреть тюнинги</a
								>
							</div>
						</div>

						<!-- Слайд 2 -->
						<div class="carousel-item" data-bs-interval="5000">
							<img
								src="/index/karusel/k2.jpg"
								class="d-block w-100"
								alt="Тюнинг"
							/>
							<div class="carousel-caption">
								<h1 class="display-4 fw-bold">
									Добро пожаловать в мир тюнинга
								</h1>
								<p class="lead">
									Уникальные решения для стиля и
									производительности
								</p>
								<a href="#tuning" class="btn btn-yellow"
									>Посмотреть тюнинги</a
								>
							</div>
						</div>

						<!-- Слайд 3 -->
						<div class="carousel-item" data-bs-interval="5000">
							<img
								src="/index/karusel/k3.jpg"
								class="d-block w-100"
								alt="Тюнинг"
							/>
							<div class="carousel-caption">
								<h1 class="display-4 fw-bold">
									Добро пожаловать в мир тюнинга
								</h1>
								<p class="lead">
									Уникальные решения для стиля и
									производительности
								</p>
								<a href="#tuning" class="btn btn-yellow"
									>Посмотреть тюнинги</a
								>
							</div>
						</div>
					</div>

					<button
						class="carousel-control-prev"
						type="button"
						data-bs-target="#carouselExample"
						data-bs-slide="prev"
					>
						<span
							class="carousel-control-prev-icon"
							aria-hidden="true"></span>
					</button>
					<button
						class="carousel-control-next"
						type="button"
						data-bs-target="#carouselExample"
						data-bs-slide="next"
					>
						<span
							class="carousel-control-next-icon"
							aria-hidden="true"></span>
					</button>
				</div>
			</div>
		</section>

		<!-- Секция "О проекте" -->
		<section class="wide-container my-5">
			<div class="row align-items-stretch">
				<div class="col-lg-6">
					<div class="p-4 bg-gradient rounded shadow h-100">
						<h2 class="section-title">О проекте</h2>
						<p>
							CarTuningLib — это ваш универсальный гид в мире
							автомобильного тюнинга Мы не просто собираем
							информацию — мы создаем сообщество энтузиастов,
							профессионалов и новичков, которые ценят
							индивидуальность и техническое совершенство
							автомобилей.
						</p>
						<p>
							🔧 Что мы предлагаем? История тюнинга – от первых
							кастомных моделей до современных гиперкаров.
							Узнайте, как зарождались культовые стили, такие как
							JDM (Japanese Domestic Market), Euro Tuning,
							Lowriders, Rat Look и многие другие. Современные
							технологии – разбираемся в чип-тюнинге,
							аэродинамических доработках, адаптивной подвеске и
							электрификации двигателей. Культурные особенности –
							почему в Германии любят «чистый» OEM-стиль, а в США
							популярны маслкары с огромными турбинами? Как аниме
							и поп-культура повлияли на японский тюнинг?
							Практические руководства – от выбора дисков и
							обвесов до сложных доработок двигателя.
						</p>
						<p>
							🚗 Стили, которые мы исследуем: VIP-стиль (Япония) –
							роскошь, низкие sedan’ы и хромированные диски.
							Bosozoku – экстремальные обвесы, выхлопные трубы «в
							потолок» и бунтарский дух. Hellaflush – агрессивный
							развал, посадка «в пол» и идеальные пропорции.
							Resto-mod – классические авто с современной
							начинкой. Cyberpunk / Hi-Tech – неоновые подсветки,
							углерод и цифровые приборные панели.
						</p>
						<p>
							🌍 Тюнинг без границ Мы сравниваем подходы мастеров
							из разных стран: Япония – акцент на детализацию и
							баланс. Германия – инженерная точность и
							производительность. США – мощность, дрэг-рейсинг и
							уникальные кастом-проекты. Россия и СНГ – смелые
							эксперименты и адаптация трендов под местные
							условия.
						</p>
					</div>
				</div>
				<div class="col-lg-6">
					<div class="h-100 overflow-hidden rounded shadow">
						<img
							src="/index/body/o_proecte.jpg"
							class="img-fluid w-100 h-100 object-fit-cover"
						/>
					</div>
				</div>
			</div>
		</section>

		<!-- Выбор страны -->
		<section class="wide-container my-5">
			<h2 class="text-center section-title">Выберите страну</h2>
			<div class="row g-4">
				{
					countries.map((country) => (
						<div class="col-md-3 d-flex">
							<a
								href={country.link}
								class="card flag-card text-decoration-none text-dark w-100"
							>
								<div style="height: 150px; overflow: hidden;">
									<img
										src={country.flag}
										class="card-img-top h-100 object-fit-cover"
										alt={`Флаг ${country.name}`}
										style="border-radius: 12px 12px 0 0;"
									/>
								</div>
								<div class="card-body text-center d-flex flex-column">
									<h3 class="card-title mb-0">
										{country.name}
									</h3>
								</div>
							</a>
						</div>
					))
				}
			</div>
		</section>

		<!-- Секция статей -->
		<section class="wide-container my-5 fade-in">
			<h2 class="section-title text-center mb-5">Последние статьи</h2>

			<div class="row g-4" id="articlesContainer">
				{
					articles.map((article) => (
						<div
							class="col-lg-4 col-md-6 article-item"
							data-category={article.category}
						>
							<div class="card article-card h-100">
								<img
									src={article.image}
									class="card-img-top"
									alt={article.title}
									loading="lazy"
								/>
								<div class="card-body">
									<span class="badge bg-warning text-dark mb-3">
										{article.category}
									</span>
									<h3 class="card-title">{article.title}</h3>
									<p class="card-text">{article.excerpt}</p>
								</div>
								<div class="card-footer bg-transparent border-top-0">
									<button
										class="btn btn-yellow w-100 article-modal-btn"
										data-id={article.id}
									>
										Читать{" "}
										<i class="fas fa-arrow-right ms-1" />
									</button>
								</div>
							</div>
						</div>
					))
				}
			</div>
		</section>

		<!-- Модальное окно для статей -->
		<div
			class="modal fade"
			id="articleModal"
			tabindex="-1"
			aria-hidden="true"
		>
			<div class="modal-dialog modal-lg modal-dialog-centered">
				<div class="modal-content bg-dark text-light">
					<div class="modal-header border-0">
						<h3 class="modal-title" id="articleModalTitle"></h3>
						<button
							type="button"
							class="btn-close btn-close-white"
							data-bs-dismiss="modal"
							aria-label="Close"></button>
					</div>
					<div class="modal-body" id="articleModalContent"></div>
					<div class="modal-footer border-0">
						<button
							type="button"
							class="btn btn-yellow"
							data-bs-dismiss="modal">Закрыть</button
						>
					</div>
				</div>
			</div>
		</div>
	</main>

	<BackToTop />

