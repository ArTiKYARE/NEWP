---
// src/pages/japan.astro
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";

const cars = [
  {
    title: "Toyota Supra MK4",
    image: "/japan/main/mk4.png",
    specs: ["3.0L 2JZ-GTE", "320 л.с.", "RWD"],
    year: 1993,
  },
  {
    title: "Mazda RX-7 FD3S",
    image: "/japan/main/rx7.png",
    specs: ["1.3L 13B-REW", "280 л.с.", "Роторный двигатель"],
    year: 2002,
  },
  {
    title: "Nissan Skyline GT-R R34",
    image: "/japan/main/r34.png",
    specs: ["2.6L RB26DETT", "280 л.с.", "ATTESA E-TS система"],
    year: 2002,
  },
];
---

<Layout title="Японский тюнинг - CarTuningLibrary">
  <Header />

  <main class="container mt-5 pt-4">
    <!-- Заголовок -->
    <h1 class="text-center section-title mb-5 fade-in">Японский тюнинг</h1>

    <!-- Основной контент -->
    <section class="fade-in">
      <div class="row g-5 align-items-stretch">
        <div class="col-lg-6">
          <div class="bg-gradient p-4 rounded-3 shadow h-100">
            <h2 class="mb-4">Искусство японского тюнинга</h2>
            <p class="lead">
              В основе JDM-культуры лежит синтез инженерного мастерства и
              философии "моно-но аварэ" (очарование вещей), где каждая деталь
              обретает особую ценность.
            </p>
            <ul class="list-unstyled">
              <li class="mb-3">
                ➤ Двигатели - доведенные до совершенства механические симфонии
              </li>
              <li class="mb-3">
                ➤ Подвеска - хореография точности и управляемости
              </li>
              <li class="mb-3">➤ Дизайн - аэродинамическая поэзия в металле</li>
              <li class="mb-3">
                ➤ Интерьер - минимализм как высшая форма функциональности
              </li>
            </ul>
          </div>
        </div>

        <div class="col-lg-6">
          <div class="h-100">
            <img
              src="/japan/main/culture/j1.jpg"
              alt="Элегантный японский тюнинг: Nissan Skyline R34 на горном серпантине"
              class="img-fluid rounded-3 shadow w-100 h-100 object-fit-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Популярные модели -->
    <section class="my-5 fade-in">
      <h2 class="section-title text-center mb-5">Легендарные модели</h2>
      <div class="row g-4">
        {
          cars.map((car, index) => (
            <div class="col-md-4">
              <div class="card article-card h-100">
                <img
                  src={car.image}
                  class="card-img-top"
                  alt={car.title}
                  loading="lazy"
                />
                <div class="card-body">
                  <h3 class="card-title fw-bold">{car.title}</h3>
                  <div class="d-flex justify-content-between mb-3">
                    <span class="badge bg-warning text-dark">{car.year}</span>
                    <div class="specs">
                      {car.specs.map((spec) => (
                        <span class="badge bg-secondary me-1">{spec}</span>
                      ))}
                    </div>
                  </div>
                  <a href="#" class="btn btn-yellow w-100">
                    Подробнее
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Культурный блок -->
    <section class="bg-gradient p-4 rounded-3 shadow my-5 fade-in">
      <h2 class="mb-4">Философия JDM</h2>
      <div class="row">
        <div class="col-md-6">
          <p class="lead">
            JDM (Japanese Domestic Market) - это не просто автомобили или
            тюнинг, а целая философия, объединяющая инженерное совершенство и
            культурное наследие. Основные принципы:
          </p>
          <ul>
            <li>
              <strong>Оригинальность превыше всего</strong> - использование аутентичных
              японских запчастей и комплектаций
            </li>
            <li>
              <strong>Уважение к инженерной мысли</strong> - сохранение заводского
              характера автомобиля с осмысленными доработками
            </li>
            <li>
              <strong>Качество важнее показухи</strong> - акцент на надежности и
              балансе, а не на гонке за лошадиными силами
            </li>
            <li>
              <strong>Минимализм и функциональность</strong> - чистый стиль без излишеств,
              где каждая деталь имеет назначение
            </li>
          </ul>
        </div>
        <div class="col-md-6">
          <img
            src="/japan/main/culture/j1.jpg"
            alt="Культура JDM: классический японский спортивный автомобиль"
            class="img-fluid rounded-3"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <section class="jdm-history py-5 fade-in">
      <div class="container">
        <h2 class="section-title text-center mb-5">
          История JDM: от послевоенного восстановления до мировой культуры
        </h2>

        <!-- 1950-1960-е -->
        <div class="row align-items-center mb-5 g-5">
          <div class="col-lg-6">
            <div class="article-card h-100">
              <img
                src="/japan/main/history/Toyota 2000GT 1967.png"
                alt="Toyota 2000GT 1967"
                class="img-fluid rounded-3 w-100"
                loading="lazy"
              />
            </div>
          </div>
          <div class="col-lg-6">
            <div class="bg-gradient p-4 rounded-3 shadow h-100">
              <h3 class="mb-4">1950–1960-е: Рождение японского автопрома</h3>
              <p>
                После Второй мировой Япония сосредоточилась на восстановлении.
                Первые модели были простыми и доступными:
              </p>
              <ul class="list-unstyled">
                <li class="mb-3">
                  ➤ <strong>Toyota SA (1947)</strong> - первый послевоенный автомобиль
                  с 4-цилиндровым 27-сильным двигателем
                </li>
                <li class="mb-3">
                  ➤ <strong>Datsun 1000 (1958)</strong> - компактный и экономичный,
                  начало экспорта
                </li>
                <li class="mb-3">
                  ➤ <strong>Toyota 2000GT (1967)</strong> - первый японский суперкар,
                  150 л.с., 220 км/ч
                </li>
              </ul>
              <div class="mt-4 p-3 bg-dark text-light rounded">
                <h5 class="text-warning">Культурный факт:</h5>
                <p>
                  2000GT снялся в бондиане "Живёшь только дважды" (1967),
                  впервые показав миру японский автопром.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- 1970-1980-е -->
        <div class="row align-items-center mb-5 g-5 flex-lg-row-reverse">
          <div class="col-lg-6">
            <div class="article-card h-100">
              <img
                src="/japan/main/history/Mazda RX-3 1971.png"
                alt="Mazda RX-3 1971"
                class="img-fluid rounded-3 w-100"
                loading="lazy"
              />
            </div>
          </div>
          <div class="col-lg-6">
            <div class="bg-gradient p-4 rounded-3 shadow h-100">
              <h3 class="mb-4">1970–1980-е: Нефтяной кризис и инновации</h3>
              <p>
                Кризис 1973 года заставил пересмотреть подход к
                автомобилестроению:
              </p>
              <ul class="list-unstyled">
                <li class="mb-3">
                  ➤ <strong>Mazda RX-3 (1971)</strong> - роторный двигатель 10A,
                  победа в 100-часовой гонке на Нюрбургринге
                </li>
                <li class="mb-3">
                  ➤ <strong>Nissan Skyline GT-R KPGC110 (1973)</strong> - последний
                  GT-R до 16-летнего перерыва
                </li>
                <li class="mb-3">
                  ➤ <strong>Honda Civic CVCC (1975)</strong> - первый двигатель,
                  соответствующий строгим американским нормам
                </li>
              </ul>
              <div class="mt-4 p-3 bg-dark text-light rounded">
                <h5 class="text-warning">Технология:</h5>
                <p>
                  CVCC (Compound Vortex Controlled Combustion) - революционная
                  система сгорания без катализатора.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- 1990-е -->
        <div class="row align-items-center mb-5 g-5">
          <div class="col-lg-6">
            <div class="article-card h-100">
              <img
                src="/japan/main/history/JDM Legends 1990s.png"
                alt="JDM Legends 1990s"
                class="img-fluid rounded-3 w-100"
                loading="lazy"
              />
            </div>
          </div>
          <div class="col-lg-6">
            <div class="bg-gradient p-4 rounded-3 shadow h-100">
              <h3 class="mb-4">1990-е: Золотой век JDM</h3>
              <p>Пик развития японских спортивных автомобилей:</p>
              <ul class="list-unstyled">
                <li class="mb-3">
                  ➤ <strong>Toyota Supra (JZA80, 1993)</strong> - 2JZ-GTE 3.0L Twin-Turbo,
                  280 л.с. (реально ~320)
                </li>
                <li class="mb-3">
                  ➤ <strong>Mazda RX-7 (FD3S, 1991)</strong> - 13B-REW 1.3L Twin-Rotor
                  Twin-Turbo, 255 л.с.
                </li>
                <li class="mb-3">
                  ➤ <strong>Nissan Skyline GT-R (BNR34, 1999)</strong> - RB26DETT
                  2.6L Twin-Turbo, ATTESA E-TS Pro
                </li>
              </ul>
              <div class="mt-4 p-3 bg-dark text-light rounded">
                <h5 class="text-warning">Гентльменское соглашение:</h5>
                <p>
                  С 1988 по 2004 год японские производители ограничивали
                  мощность 280 л.с., но реальные показатели часто были выше.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- 2000-е -->
        <div class="row align-items-center g-5 flex-lg-row-reverse">
          <div class="col-lg-6">
            <div class="article-card h-100">
              <img
                src="/japan/main/history/Modern JDM.png"
                alt="Modern JDM"
                class="img-fluid rounded-3 w-100"
                loading="lazy"
              />
            </div>
          </div>
          <div class="col-lg-6">
            <div class="bg-gradient p-4 rounded-3 shadow h-100">
              <h3 class="mb-4">2000-е - настоящее время: Глобализация JDM</h3>
              <p>Эволюция культуры в мировом масштабе:</p>
              <ul class="list-unstyled">
                <li class="mb-3">
                  ➤ <strong>2003</strong> - выход фильма "Форсаж: Токийский дрифт"
                </li>
                <li class="mb-3">
                  ➤ <strong>2007</strong> - прекращение производства Nissan Skyline
                  GT-R (R34)
                </li>
                <li class="mb-3">
                  ➤ <strong>2019</strong> - возвращение Toyota Supra (A90) с BMW
                  B58 двигателем
                </li>
              </ul>
              <div class="mt-4 p-3 bg-dark text-light rounded">
                <h5 class="text-warning">Рынок:</h5>
                <p>
                  Цены на R34 GT-R выросли с $30,000 в 2000-х до $200,000+ в
                  2020-х. Оригинальные AE86 в хорошем состоянии стоят $50,000+.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  // Оригинальные скрипты без изменений
  document.addEventListener("DOMContentLoaded", function () {
    // Скрипт для темы
    document
      .getElementById("themeToggle")
      .addEventListener("click", function () {
        document.body.classList.toggle("dark-theme");
        // ... остальной код
      });

    // Скрипт для кнопки "Наверх"
    const backToTopButton = document.getElementById("back-to-top");
    window.addEventListener("scroll", function () {
      if (window.scrollY > 300) {
        backToTopButton.style.display = "flex";
      } else {
        backToTopButton.style.display = "none";
      }
    });

    // Остальные скрипты...
  });
</script>

<style scoped>
  .specs .badge {
    font-size: 0.8rem;
    padding: 0.5em 0.7em;
  }

  .lead {
    font-size: 1.1rem;
    line-height: 1.7;
  }

  ul {
    padding-left: 1.5rem;
  }

  li {
    margin-bottom: 0.8rem;
    position: relative;
  }

  li::before {
    content: "•";
    color: #ffc107;
    position: absolute;
    left: -1.2rem;
  }
</style>
