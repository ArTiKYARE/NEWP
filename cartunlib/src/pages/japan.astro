---
// src/pages/japan.astro
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";

const cars = [
  {
    title: "Toyota Supra MK4",
    image: "/japan/main/mk4.png",
    specs: ["3.0L 2JZ-GTE", "320 л.с.", "RWD"],
    year: 1993,
  },
  {
    title: "Mazda RX-7 FD3S",
    image: "/japan/main/rx7.png",
    specs: ["1.3L 13B-REW", "280 л.с.", "Роторный двигатель"],
    year: 2002,
  },
  {
    title: "Nissan Skyline GT-R R34",
    image: "/japan/main/r34.png",
    specs: ["2.6L RB26DETT", "280 л.с.", "ATTESA E-TS система"],
    year: 2002,
  },
];
---

<Layout title="Японский тюнинг - CarTuningLibrary">
  <Header />

  <main class="container mt-5 pt-4">
    <!-- Заголовок -->
    <h1 class="text-center section-title mb-5 fade-in">Японский тюнинг</h1>

    <!-- Основной контент -->
    <section class="fade-in">
      <div class="row g-5">
        <div class="col-lg-6">
          <div class="bg-gradient p-4 rounded-3 shadow">
            <h2 class="mb-4">Особенности стиля</h2>
            <p class="lead">
              Японский тюнинг сочетает в себе высокие технологии и философию
              "кайдзен" (постоянное совершенствование). Основные направления:
            </p>
            <ul class="list-unstyled">
              <li class="mb-3">
                ➤ Доработка двигателей для достижения максимальной надежности
              </li>
              <li class="mb-3">
                ➤ Точная настройка подвески для идеального баланса
              </li>
              <li class="mb-3">
                ➤ Минималистичный экстерьер с акцентом на аэродинамику
              </li>
            </ul>
          </div>
        </div>

        <div class="col-lg-6 fade-in">
          <img
            src="/japan/main/culture/j1.jpg"
            alt="Японский тюнинг"
            class="img-fluid rounded-3 shadow"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- Популярные модели -->
    <section class="my-5 fade-in">
      <h2 class="section-title text-center mb-5">Легендарные модели</h2>
      <div class="row g-4">
        {
          cars.map((car, index) => (
            <div class="col-md-4">
              <div class="card article-card h-100">
                <img
                  src={car.image}
                  class="card-img-top"
                  alt={car.title}
                  loading="lazy"
                />
                <div class="card-body">
                  <h3 class="card-title fw-bold">{car.title}</h3>
                  <div class="d-flex justify-content-between mb-3">
                    <span class="badge bg-warning text-dark">{car.year}</span>
                    <div class="specs">
                      {car.specs.map((spec) => (
                        <span class="badge bg-secondary me-1">{spec}</span>
                      ))}
                    </div>
                  </div>
                  <a href="#" class="btn btn-yellow w-100">
                    Подробнее
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Культурный блок -->
    <section class="bg-gradient p-4 rounded-3 shadow my-5 fade-in">
      <h2 class="mb-4">Философия JDM</h2>
      <div class="row">
        <div class="col-md-6">
          <p class="lead">
            JDM (Japanese Domestic Market) - не просто стиль тюнинга, а целая
            культура, включающая:
          </p>
          <ul>
            <li>Использование оригинальных японских запчастей</li>
            <li>Сохранение заводского характера автомобиля</li>
            <li>Акцент на качестве а не количестве лошадиных сил</li>
          </ul>
        </div>
        <div class="col-md-6">
          <img
            src="/japan/main/culture/j1.jpg"
            alt="JDM культура"
            class="img-fluid rounded-3"
            loading="lazy"
          />
        </div>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  // Оригинальные скрипты без изменений
  document.addEventListener("DOMContentLoaded", function () {
    // Скрипт для темы
    document
      .getElementById("themeToggle")
      .addEventListener("click", function () {
        document.body.classList.toggle("dark-theme");
        // ... остальной код
      });

    // Скрипт для кнопки "Наверх"
    const backToTopButton = document.getElementById("back-to-top");
    window.addEventListener("scroll", function () {
      if (window.scrollY > 300) {
        backToTopButton.style.display = "flex";
      } else {
        backToTopButton.style.display = "none";
      }
    });

    // Остальные скрипты...
  });
</script>

<style scoped>
  .specs .badge {
    font-size: 0.8rem;
    padding: 0.5em 0.7em;
  }

  .lead {
    font-size: 1.1rem;
    line-height: 1.7;
  }

  ul {
    padding-left: 1.5rem;
  }

  li {
    margin-bottom: 0.8rem;
    position: relative;
  }

  li::before {
    content: "•";
    color: #ffc107;
    position: absolute;
    left: -1.2rem;
  }
</style>
